  "keywords": ["search", "memory", "rag", "notes", "knowledge-base", "local-first", "mcp"],
  "mcpServers": {
    "br8n": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/br8n.sh",
      "args": [
        "mcp"
      ]
    }
  }
}
