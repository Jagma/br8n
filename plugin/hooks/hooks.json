{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{BR8N_BIN}}\" hook prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{BR8N_BIN}}\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
